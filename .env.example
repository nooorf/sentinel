# Copy to .env. No secrets belong here. All variables are optional (defaults shown).
SENTINEL_DATA_PATH=data/raw/creditcard.csv
SENTINEL_DATA_DIR=var
# Dev mode: keep all fraud rows + this fraction of legitimate rows (empty = full dataset)
SENTINEL_SAMPLE_FRAC=
SENTINEL_TARGET_RECALL=0.80
# Monitoring
SENTINEL_MONITOR_WINDOW=1000
SENTINEL_MONITOR_MIN_SAMPLES=200
SENTINEL_DRIFT_SHARE_THRESHOLD=0.30
SENTINEL_PREDICTION_DRIFT_TRIGGERS=false
SENTINEL_AUTO_RETRAIN_ON_DRIFT=false
# Retraining promotion policy
SENTINEL_RETRAIN_MIN_FRAUD=20
# Drift-triggered runs wait for this many fraud labels on the active model's traffic (0 = off)
SENTINEL_RETRAIN_MIN_NEW_FRAUD_LABELS=0
SENTINEL_GATE_MIN_RECALL=0.70
SENTINEL_GATE_MIN_PRECISION=0.30
SENTINEL_GATE_MIN_PR_AUC_DELTA=0.0
SENTINEL_GATE_MIN_VAL_FRAUDS=30
